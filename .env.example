# Copy to .env and edit. All variables are optional; defaults are shown.
# Never commit .env — it's already in .gitignore.

# ─── Identity / general ──────────────────────────────────────────────
LILY_NAME=Lily
LILY_LOG_LEVEL=INFO
LILY_LOG_DIR=./logs

# ─── Speech-to-text ──────────────────────────────────────────────────
# base.en is ~150 MB warm; much better command accuracy than tiny.en.
# Downgrade to tiny.en only if RAM is tight.
LILY_STT_ENGINE=faster-whisper
LILY_STT_MODEL=base.en
LILY_STT_DEVICE=cpu               # cpu | cuda | auto
LILY_STT_COMPUTE_TYPE=int8        # int8 | float16 | float32
LILY_STT_LANGUAGE=en
# 0 = never unload (keeps STT instant). Set to 60+ to save RAM when idle.
LILY_STT_WARM_TTL_S=0

# ─── Activation ──────────────────────────────────────────────────────
# wake    = always listening, triggered by "Hey Lily, ..." (Siri-like)
# hotkey  = push-to-talk (hold hotkey to speak) — for privacy / gaming
LILY_ACTIVATION=wake
LILY_HOTKEY=<ctrl>+<alt>+<space>  # only used when activation=hotkey
LILY_WAKE_WORD=lily
LILY_WAKE_SILENCE_MS=1000          # trailing silence that ends your sentence
LILY_WAKE_MIN_SPEECH_MS=300        # ignore anything shorter (coughs, keystrokes)
LILY_WAKE_ENERGY_FLOOR=200         # min RMS to consider speech; adapts to noise

# ─── Text-to-speech (Lily talks back) ────────────────────────────────
LILY_TTS_ENGINE=pyttsx3           # pyttsx3 (Windows SAPI, no download) | piper | none
LILY_TTS_GENDER=female            # female | male | any — auto-picks a SAPI voice
LILY_TTS_VOICE=                   # exact voice name override (Zira, Hazel, David…)
LILY_TTS_RATE=190                 # words per minute
LILY_TTS_ENABLED=true

# ─── Visual "Hey Lily" orb (Siri-style floating popup) ───────────────
LILY_ORB_ENABLED=true

# ─── LLM brain (OpenRouter, OpenAI-compatible) ───────────────────────
# Set provider=openrouter + a valid API key to unlock general-purpose answers:
#   "what time is it in Tokyo"  →  LLM calls system.time tool + does math
#   "translate hello to Spanish" →  LLM answers directly
#   "close spotify"              →  LLM calls apps.close(spotify) via function calling
# The fast router still handles common commands ("volume up", "open notepad") with zero LLM cost.
LILY_LLM_PROVIDER=openrouter      # none | openrouter | openai_compat | ollama
LILY_LLM_MODEL=openai/gpt-4o-mini # cheap+fast for tool routing. gpt-4o for higher quality.
LILY_LLM_BASE_URL=https://openrouter.ai/api/v1
LILY_LLM_API_KEY=                 # put your OpenRouter key here — never commit
LILY_LLM_TIMEOUT_S=30

# ─── Safety ──────────────────────────────────────────────────────────
LILY_CONFIRM_DESTRUCTIVE=true

# ─── Feature toggles ─────────────────────────────────────────────────
LILY_SPOTIFY_ENABLED=false
LILY_BROWSER_DEFAULT=brave        # brave | chrome | edge | firefox
LILY_TRAY_ENABLED=true

# ─── Game mode ───────────────────────────────────────────────────────
# When a fullscreen game is detected, unload warm models to free RAM/CPU.
LILY_GAME_MODE=auto               # auto | off (never suspend) | on (always suspend)

# ─── IPC (used by `lily do "..."` to talk to the running daemon) ─────
LILY_IPC_PIPE=lily
